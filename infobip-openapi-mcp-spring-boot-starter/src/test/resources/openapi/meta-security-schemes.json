        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/anonymous": {
      "get": {
        "operationId": "get-anonymous",
        "security": [
          {}
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
